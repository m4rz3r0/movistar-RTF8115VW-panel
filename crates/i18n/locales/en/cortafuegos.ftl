# Full firewall editor (filters and rules).
ajuste-seguridad-cortafuegos-editor-ayuda = Each filter groups the rules for one connection and direction. The router checks them in order and applies the first one that matches; anything that matches none follows the filter's default.
ajuste-seguridad-cortafuegos-editor-sin-leer = The firewall filters cannot be read for editing: only the list of rules is shown.
ajuste-seguridad-cortafuegos-editor-por-defecto = by default, { $accion }
ajuste-seguridad-cortafuegos-editor-reglas-de = Rules of { $filtro }
ajuste-seguridad-cortafuegos-editor-vacio = No rules: the filter applies its default to everything.
ajuste-seguridad-cortafuegos-editor-col-orden = No.
ajuste-seguridad-cortafuegos-editor-col-activa = Active
ajuste-seguridad-cortafuegos-editor-col-trafico = Traffic
ajuste-seguridad-cortafuegos-editor-col-accion = What it does
ajuste-seguridad-cortafuegos-editor-col-desde = From
ajuste-seguridad-cortafuegos-editor-col-hacia = To
ajuste-seguridad-cortafuegos-editor-col-puertos = Ports
ajuste-seguridad-cortafuegos-editor-col-acciones = Actions
ajuste-seguridad-cortafuegos-editor-cualquiera = Any
ajuste-seguridad-cortafuegos-editor-todo = All
ajuste-seguridad-cortafuegos-editor-si = Yes
ajuste-seguridad-cortafuegos-editor-no = No
