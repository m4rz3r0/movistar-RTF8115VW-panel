# Unidad de usuario de systemd (opcional) del PC de compilación: compila la
# última etiqueta v* para FreeBSD y la entrega al buzón del servidor si aún no
# se ha hecho. La lanza rtf-cross.timer. No se instala ni se activa sola:
# ver deploy/freebsd-jail/README.md, «Versiones precompiladas».
#
# Necesita ~/.config/rtf-cross.env con
#   RP_REPO_URL=<URL de git del repositorio, la misma que REPO_URL>
#   RP_BUZON_SSH=rpentrega@<servidor>
# y los guiones en ~/rtf-cross/bin (los copia deploy/cross/lanzar.sh).

[Unit]
Description=Compilar el panel para FreeBSD en el PC de compilación
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/rtf-cross.env
ExecStart=/usr/bin/bash %h/rtf-cross/bin/cross/compilar-freebsd.sh --ultima --repo ${RP_REPO_URL} --entregar ${RP_BUZON_SSH}
Nice=10
TimeoutStartSec=90min
