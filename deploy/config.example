# Configuración de la instalación en jail de FreeBSD (deploy/freebsd-jail/).
#
# Cópiala a deploy/config.local (git la ignora) y cambia los valores. Es sh:
# CLAVE=valor, con comillas si el valor lleva espacios o «$». También puedes
# dejar en config.local solo lo que cambia, empezando por la línea
#   . "$CONFIG_EJEMPLO"
# que carga este fichero.
#
# Los valores de aquí son de documentación (192.0.2.x, *.example): no
# funcionan tal cual.

# Usuario y equipo FreeBSD donde se instala (ssh, y doas como root allí).
SERVIDOR_SSH=admin@192.0.2.10

# Dónde viven las jails y su dataset ZFS (las rutas del manual de FreeBSD).
JAILS_RAIZ=/usr/local/jails/containers
ZFS_DATASET=zroot/jails/containers

# Jail del panel: solo el binario y su web; su única salida es el router.
JAIL_PANEL=routerpanel
JAIL_PANEL_IP=192.0.2.20

# Interfaz de salida del host para el nat de pf (o una macro de tu pf.conf,
# entre comillas simples).
INTERFAZ_EXT=em0

# IP de la web del router (la de fábrica es 192.168.1.1).
ROUTER_IP=192.168.1.1

# Dirección pública del panel, como la escribe el navegador (RP_ORIGIN; varias
# separadas por comas).
PANEL_ORIGEN=https://panel.example
# IP:puerto donde escucha el panel dentro de su jail (RP_LISTEN).
PANEL_ESCUCHA=192.0.2.20:3000
# Proxies inversos delante del panel: IPs o redes separadas por comas
# (RP_TRUSTED_PROXY). pf solo les deja llegar a ellos (y a la propia jail,
# para /salud).
PROXIES_CONFIANZA=192.0.2.10

# Repositorio en el que el actualizador busca las etiquetas vX.Y.Z (con
# git ls-remote desde el host; el servidor no compila ni clona): cualquier
# URL de git (https://… o ssh://git@equipo:puerto/…).
REPO_URL=https://git.example/routerpanel.git
# Línea de known_hosts del servidor git por SSH, p. ej.
# «[192.0.2.30]:2222 ssh-ed25519 …». Vacía: install.sh fija la primera
# clave que presente. Con https no hace falta.
REPO_HOST_CLAVE=

# Qué se instala: pf (reglas con interruptor de hombre muerto), rc (jail y
# servicio del panel), actualizador (actualizador y cron en el host, con su
# clave de despliegue). Opcionales: caddyfile (genera el sitio para tu
# Caddyfile) y unbound (nombre del panel en el unbound del host).
MODULOS="pf rc actualizador"

# De dónde saca el actualizador las versiones ya compiladas para FreeBSD
# (ver freebsd-jail/README.md). Instala la de la primera fuente que la
# tenga y pase las comprobaciones; si ninguna la tiene, espera.
#
# La release de GitHub del repositorio, «propietario/nombre» (opcional):
# archivo, SHA256SUMS y su atestación de origen, comprobada con
# gh attestation verify. Con ella, install.sh instala gh y jq en el host.
# Vacía: no se mira GitHub.
GITHUB_REPO=
# El buzón donde deja las versiones el PC de compilación (deploy/cross/):
# siempre se mira. Clave pública de minisign con la que el PC firma
# SHA256SUMS (la segunda línea del .pub). Vacía: sin firma (vale con el
# sha256 y la clave SSH del buzón). Con ella, el host necesita el paquete
# minisign. No se aplica a GitHub, que va con su atestación.
PRECOMPILADAS_MINISIGN=
# Para deploy/cross/lanzar.sh, desde este equipo: cómo se entra por SSH al PC
# de compilación y, desde el PC, al usuario del buzón del servidor.
PC_COMPILAR_SSH=
PRECOMPILADAS_BUZON_SSH=

# Webs que tienen que seguir respondiendo al cargar las reglas de pf,
# separadas por espacios (opcional; si alguna falla, pf vuelve atrás solo).
COMPROBAR_URLS=
