# Configuración del panel (routerpanel.service). Cópiala a
# /etc/routerpanel/env (root, 644 o 600) y ajusta los valores. Formato de
# EnvironmentFile de systemd: CLAVE=valor, sin «export». Cada variable va con
# su valor por defecto; las comentadas no hacen falta.

# Dirección donde escucha el panel. Por defecto solo este equipo: pon el
# proxy inverso en el mismo equipo o cambia la IP (y IPAddressAllow).
RP_LISTEN=127.0.0.1:3000

# Base de datos SQLite (usuarios, credenciales del router cifradas,
# historial). Dentro de StateDirectory=routerpanel, el único sitio donde el
# servicio puede escribir.
RP_DB=/var/lib/routerpanel/panel.db

# Clave maestra que cifra las credenciales del router y los secretos del
# historial; el panel la crea al arrancar si no existe. También en
# /var/lib/routerpanel (el /etc/routerpanel del servicio es de solo lectura).
# No la pierdas: sin ella no se descifra lo que hay en panel.db.
RP_HISTORY_KEY=/var/lib/routerpanel/history.key

# Obligatoria: la dirección del panel tal como la escribe el navegador,
# http(s)://equipo[:puerto], sin ruta ni «/» final; varias, separadas por
# comas (p. ej. https://panel.example). El panel rechaza las peticiones que
# cambian algo si vienen de otro origen.
RP_ORIGIN=

# Proxies inversos de confianza: IPs o redes separadas por comas. Solo de
# ellos se lee X-Forwarded-For para saber la IP del cliente.
RP_TRUSTED_PROXY=127.0.0.1

# Redes, además de las privadas, desde las que responde el asistente de
# instalación (separadas por comas; por defecto, ninguna).
#RP_INSTALL_NETS=

# Nivel de registro (sintaxis de tracing EnvFilter: error, warn, info, debug).
RP_LOG=info

# Solo para instalaciones anteriores al asistente: router y fichero con su
# contraseña, que el panel importa una vez a la base de datos. En una
# instalación nueva, el asistente los pide; déjalas comentadas.
#RP_ROUTER_URL=http://192.168.1.1
#RP_ROUTER_USER=
#RP_ROUTER_SECRET=
